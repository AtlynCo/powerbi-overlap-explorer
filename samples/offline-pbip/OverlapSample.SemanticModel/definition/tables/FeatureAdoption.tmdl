table FeatureAdoption

	measure 'Feature highlight signal' = COUNTROWS('FeatureAdoption')
		formatString: 0

	measure 'Feature distinct entities' = DISTINCTCOUNT('FeatureAdoption'[Entity ID])
		formatString: 0

	column 'Entity ID'
		dataType: string
		summarizeBy: none
		sourceColumn: "Entity ID"

	column 'Set Name'
		dataType: string
		summarizeBy: none
		sourceColumn: "Set Name"

	column Cohort
		dataType: string
		summarizeBy: none
		sourceColumn: Cohort

	partition FeatureAdoption = m
		mode: import
		source =
				let
					Source = #table(
						type table [#"Entity ID" = text, #"Set Name" = nullable text, Cohort = text],
						{
							{"U001", "Search", "Pilot"},
							{"U001", "Share", "Pilot"},
							{"U002", "Search", "General"},
							{"U003", "Share", "Pilot"},
							{"U003", "Automate", "Pilot"},
							{"U004", "Search", "General"},
							{"U004", "Share", "General"},
							{"U004", "Automate", "General"},
							{"U005", "Automate", "Pilot"},
							{"U006", "Search", "General"},
							{"U006", "Automate", "General"},
							{"U007", "Share", "General"},
							{"U008", null, "Pilot"},
							{"U009", "Search", "Pilot"},
							{"U009", "Search", "Pilot"},
							{"U010", "Search", "General"},
							{"U010", "Share", "General"},
							{"U011", "Export", "Pilot"},
							{"U012", "Export", "General"},
							{"U012", "Search", "General"},
							{"U012", "Share", "General"},
							{"U012", "Automate", "General"}
						}
					)
				in
					Source
